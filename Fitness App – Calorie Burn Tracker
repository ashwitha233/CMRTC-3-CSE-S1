public class WorkoutTracker {
    String name;
    double weight;
    String workout;
    int duration;

    public WorkoutTracker(String name, double weight, String workout, int duration) {
        this.name = name;
        this.weight = weight;
        this.workout = workout;
        this.duration = duration;
    }

    public void showSummary() {
        double met = 0;
        if (workout.equals("Running")) met = 9.8;
        else if (workout.equals("Cycling")) met = 7.5;
        else if (workout.equals("Swimming")) met = 8.3;

        double calories = 0.0175 * met * weight * duration;

        System.out.println("Name: " + name);
        System.out.println("Workout: " + workout);
        System.out.println("Weight: " + weight + " kg");
        System.out.println("Duration: " + duration + " minutes");
        System.out.printf("Calories Burned: %.1f\n", calories);
    }

    public static void main(String[] args) {
        WorkoutTracker user1 = new WorkoutTracker("Neha", 60.0, "Running", 30);
        user1.showSummary();
    }
}


