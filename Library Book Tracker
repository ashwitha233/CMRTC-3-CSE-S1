public class Book {
    static String libraryName = "City Central Library";
    String title;
    int bookId;

    public static void main(String[] args) {
        int currentYear = 2025;

        Book book1 = new Book();
        book1.title = "Java Basics";
        book1.bookId = 101;
        Book book2 = new Book();
        book2.title = "Python guide";
        book2.bookId = 102;
        System.out.println("Library: " + Book.libraryName);
        System.out.println("Book Title: " + book1.title);
        System.out.println("Book ID: " + book1.bookId);
        System.out.println("Year: " + currentYear);
        System.out.println();
        System.out.println("Library: " + Book.libraryName);
        System.out.println("Book Title: " + book2.title);
        System.out.println("Book ID: " + book2.bookId);
        System.out.println("Year: " + currentYear);
    }
}
