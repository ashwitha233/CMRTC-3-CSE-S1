class Delivery {
    static int baseCharge = 50;
    String customerName;
    int distanceInKm;
    int calculateDeliveryCharge() {
        int ratePerKm = 10;
        int totalCharge = baseCharge + (distanceInKm * ratePerKm);
        return totalCharge;
    }
    void displayDetails() {
        System.out.println("Customer: " + customerName);
        System.out.println("Distance: " + distanceInKm + " km");
        System.out.println("Total Delivery Charge: ₹" + calculateDeliveryCharge());
        System.out.println(); 
    }
    public static void main(String[] args) {
        Delivery customer1 = new Delivery();
        customer1.customerName = "Arjun";
        customer1.distanceInKm = 5;
        Delivery customer2 = new Delivery();
        customer2.customerName = "Sneha";
        customer2.distanceInKm = 10;
        customer1.displayDetails();
        customer2.displayDetails();
    }
}
